# ═══════════════════════════════════════════════════════════
# Origin Night — ALL party content lives here (.env)
# Copy to .env and edit. Never commit .env
# Restart server after changes: npm start
# ═══════════════════════════════════════════════════════════

# ── Who the party is for ──────────────────────────────────
NAME=Alex
AGE=25
FROM=
# batman | spiderman
THEME=batman

# ── Balloon wishes (REQUIRED) ─────────────────────────────
# Pipe-separated. One message per balloon (cycles if fewer than count).
WISHES_COUNT=6
WISHES=Wish one goes here.|Wish two goes here.|Wish three goes here.|Wish four goes here.|Wish five goes here.|Wish six goes here.

# Shown on the cake after every candle is blown out
CAKE_WISH=Wish sealed. Make this year count.

# ── Unlock gate (timeapi.io) ──────────────────────────────
TIMEZONE=Asia/Karachi
CITY_LABEL=Karachi, Pakistan
# Local wall-clock in TIMEZONE — site locked until then
UNLOCK_AT=2026-12-25T00:00:00

# ── Invite tokens (one per guest) ─────────────────────────
# Share a DIFFERENT link with each person:
#   https://YOUR-SITE/?k=guest1-secret
#   https://YOUR-SITE/?k=guest2-secret
# After a guest seals, ONLY their token locks — others still work.
#
# Single guest:
PARTY_TOKEN=change-me-to-a-long-secret
# Multiple guests (comma-separated). Merged with PARTY_TOKEN if both set.
# PARTY_TOKENS=guest-one-secret,guest-two-secret,guest-three-secret
#
# Want one shared link everyone can reuse? Set:
# PARTY_ONE_SHOT=false
PARTY_ONE_SHOT=true

# Optional on Vercel (persistent lock across serverless):
# Free Upstash Redis → https://upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Email (secret — never sent to the browser) ────────────
CREATOR_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
EMAIL_FROM="Origin Night <you@example.com>"

PORT=3000
